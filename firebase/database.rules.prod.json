{
  "rules": {
    ".read": false,
    ".write": false,
    "familyMembers": {
      "$familyId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "ownerMembers": {
      "$familyId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "families": {
      "$familyId": {
        ".read": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true",
        ".write": false,
        "ownerUid": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && (!data.exists() || data.val() === auth.uid || root.child('ownerMembers').child($familyId).child(auth.uid).val() === true)",
          ".validate": "newData.val() === null || (newData.isString() && (newData.val() === auth.uid || root.child('ownerMembers').child($familyId).child(auth.uid).val() === true))"
        },
        "ownerCodeHash": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^sha256:[0-9a-f]{64}$/)"
        },
        "ownerCodePlain": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length >= 4 && newData.val().length <= 100)"
        },
        "travelerCodeHash": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^sha256:[0-9a-f]{64}$/)"
        },
        "travelerCodePlain": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length >= 4 && newData.val().length <= 100)"
        },
        "ownerProfileId": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.val() === null || newData.isString()"
        },
        "updatedAt": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.isNumber()"
        },
        "profiles": {
          "$profileId": {
            ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true",
            "surname": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "role": {
              ".validate": "newData.val() === 'proprietaire' || newData.val() === 'utilisateur' || newData.val() === 'visiteur'"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "lastSyncAt": {
              ".validate": "newData.isNumber()"
            },
            "passwordHash": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^sha256:[0-9a-f]{64}$/))"
            },
            "recoveryHash": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^sha256:[0-9a-f]{64}$/))"
            },
            "recoveryQuestion": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 200)"
            },
            "recoveryAnswer": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 200)"
            },
            "recoveryConfiguredAt": {
              ".validate": "newData.val() === null || newData.isNumber()"
            },
            "gender": {
              ".validate": "newData.val() === 'unspecified' || newData.val() === 'male' || newData.val() === 'female'"
            },
            "householdRole": {
              ".validate": "newData.val() === 'member' || newData.val() === 'parent' || newData.val() === 'child'"
            },
            "customChecklistItems": {
              "$itemId": {
                ".validate": "newData.hasChildren(['id','label','categoryId']) && newData.child('id').isString() && newData.child('label').isString() && newData.child('categoryId').isString() && (!newData.child('genderTargets').exists() || newData.child('genderTargets').val() === 'all' || newData.child('genderTargets').val() === 'male' || newData.child('genderTargets').val() === 'female') && (!newData.child('householdRoleTargets').exists() || newData.child('householdRoleTargets').val() === 'all' || newData.child('householdRoleTargets').val() === 'parent' || newData.child('householdRoleTargets').val() === 'child') && (!newData.child('ownerOnly').exists() || newData.child('ownerOnly').isBoolean()) && (!newData.child('visibleToProfileId').exists() || newData.child('visibleToProfileId').isString())"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "checklistCatalogAdditions": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          "$itemId": {
            ".validate": "newData.hasChildren(['id','label','categoryId']) && newData.child('id').isString() && newData.child('label').isString() && newData.child('categoryId').isString() && (!newData.child('genderTargets').exists() || newData.child('genderTargets').val() === 'all' || newData.child('genderTargets').val() === 'male' || newData.child('genderTargets').val() === 'female') && (!newData.child('householdRoleTargets').exists() || newData.child('householdRoleTargets').val() === 'all' || newData.child('householdRoleTargets').val() === 'parent' || newData.child('householdRoleTargets').val() === 'child') && (!newData.child('ownerOnly').exists() || newData.child('ownerOnly').isBoolean()) && (!newData.child('visibleToProfileId').exists() || newData.child('visibleToProfileId').isString())"
          }
        },
        "checklistCatalogRemovals": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          "$itemId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "checklists": {
          "$profileId": {
            ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true",
            "$itemId": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "placeComments": {
          "$placeId": {
            "$commentId": {
              ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && ((newData.val() === null && data.child('authorUid').val() === auth.uid) || (newData.val() !== null && data.child('authorUid').val() === auth.uid && newData.child('authorUid').val() === auth.uid))))",
              ".validate": "newData.val() === null || (newData.hasChildren(['commentId','placeId','authorProfileId','authorSurnameSnapshot','reaction','text','createdAt','updatedAt','authorUid']) && newData.child('commentId').isString() && newData.child('commentId').val() === $commentId && newData.child('placeId').isString() && newData.child('placeId').val() === $placeId && newData.child('authorProfileId').isString() && newData.child('authorProfileId').val().length > 0 && newData.child('authorSurnameSnapshot').isString() && newData.child('authorSurnameSnapshot').val().length > 0 && newData.child('authorSurnameSnapshot').val().length <= 80 && (newData.child('reaction').val() === 'like' || newData.child('reaction').val() === 'dislike') && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('createdAt').isNumber() && newData.child('updatedAt').isNumber() && newData.child('authorUid').isString() && newData.child('authorUid').val().length > 0)"
            }
          }
        },
        "gameResults": {
          "$profileId": {
            ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true",
            "$index": {
              ".validate": "newData.hasChildren(['day','location','quizScore','correctCount','riddleSolved','challengeDone','durationSec','totalScore','completedAt'])"
            }
          }
        },
        "gameProgress": {
          "$profileId": {
            ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true",
            ".validate": "newData.val() === null || (newData.hasChildren(['day','phase','quizDurationSec','riddleValidated','riddleSolved']) && (newData.child('phase').val() === 'playing' || newData.child('phase').val() === 'riddle' || newData.child('phase').val() === 'challenge') && (!newData.child('quizStartedAt').exists() || newData.child('quizStartedAt').isNumber()))"
          }
        },
        "phase": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.val() === 'before' || newData.val() === 'during'"
        },
        "gameDayOverrides": {
          "$day": {
            ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
            ".validate": "newData.val() === null || newData.val() === 'open' || newData.val() === 'closed'"
          }
        },
        "tripStartDate": {
          ".write": "auth != null && root.child('familyMembers').child($familyId).child(auth.uid).val() === true && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
