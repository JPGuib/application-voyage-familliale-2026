{
  "rules": {
    ".read": false,
    ".write": false,
    "familyMembers": {
      "$familyId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "ownerMembers": {
      "$familyId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "families": {
      "$familyId": {
        ".read": "auth != null",
        ".write": false,
        "ownerUid": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid || root.child('ownerMembers').child($familyId).child(auth.uid).val() === true)",
          ".validate": "newData.val() === null || (newData.isString() && (newData.val() === auth.uid || root.child('ownerMembers').child($familyId).child(auth.uid).val() === true))"
        },
        "ownerCodeHash": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^sha256:[0-9a-f]{64}$/)"
        },
        "ownerCodePlain": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length >= 4 && newData.val().length <= 100)"
        },
        "travelerCodeHash": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^sha256:[0-9a-f]{64}$/)"
        },
        "travelerCodePlain": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length >= 4 && newData.val().length <= 100)"
        },
        "ownerProfileId": {
          ".write": "auth != null",
          ".validate": "newData.val() === null || newData.isString()"
        },
        "updatedAt": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "profiles": {
          "$profileId": {
            ".write": "auth != null",
            "surname": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "role": {
              ".validate": "newData.val() === 'proprietaire' || newData.val() === 'utilisateur' || newData.val() === 'visiteur'"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "lastSyncAt": {
              ".validate": "newData.isNumber()"
            },
            "passwordHash": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^sha256:[0-9a-f]{64}$/))"
            },
            "recoveryHash": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^sha256:[0-9a-f]{64}$/))"
            },
            "recoveryQuestion": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 200)"
            },
            "recoveryAnswer": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 200)"
            },
            "recoveryConfiguredAt": {
              ".validate": "newData.val() === null || newData.isNumber()"
            },
            "gender": {
              ".validate": "newData.val() === 'unspecified' || newData.val() === 'male' || newData.val() === 'female'"
            },
            "householdRole": {
              ".validate": "newData.val() === 'member' || newData.val() === 'parent' || newData.val() === 'child'"
            },
            "launchGateCompletedCycle": {
              ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0)"
            },
            "customChecklistItems": {
              "$itemId": {
                ".validate": "newData.hasChildren(['id','label','categoryId']) && newData.child('id').isString() && newData.child('label').isString() && newData.child('categoryId').isString() && (!newData.child('genderTargets').exists() || newData.child('genderTargets').val() === 'all' || newData.child('genderTargets').val() === 'male' || newData.child('genderTargets').val() === 'female') && (!newData.child('householdRoleTargets').exists() || newData.child('householdRoleTargets').val() === 'all' || newData.child('householdRoleTargets').val() === 'parent' || newData.child('householdRoleTargets').val() === 'child') && (!newData.child('ownerOnly').exists() || newData.child('ownerOnly').isBoolean()) && (!newData.child('visibleToProfileId').exists() || newData.child('visibleToProfileId').isString())"
              }
            },
            "memberUids": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.isBoolean()"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "checklistCatalogAdditions": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          "$itemId": {
            ".validate": "newData.hasChildren(['id','label','categoryId']) && newData.child('id').isString() && newData.child('label').isString() && newData.child('categoryId').isString() && (!newData.child('genderTargets').exists() || newData.child('genderTargets').val() === 'all' || newData.child('genderTargets').val() === 'male' || newData.child('genderTargets').val() === 'female') && (!newData.child('householdRoleTargets').exists() || newData.child('householdRoleTargets').val() === 'all' || newData.child('householdRoleTargets').val() === 'parent' || newData.child('householdRoleTargets').val() === 'child') && (!newData.child('ownerOnly').exists() || newData.child('ownerOnly').isBoolean()) && (!newData.child('visibleToProfileId').exists() || newData.child('visibleToProfileId').isString())"
          }
        },
        "checklistCatalogRemovals": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          "$itemId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "checklists": {
          "$profileId": {
            ".write": "auth != null",
            "$itemId": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "placeComments": {
          "$placeId": {
            "$commentId": {
              ".write": "auth != null && ((newData.val() === null && (!data.exists() || data.child('authorUid').val() === auth.uid)) || (!data.exists() && newData.val() !== null && newData.child('authorUid').val() === auth.uid) || (data.exists() && newData.val() !== null && data.child('authorUid').val() === auth.uid && newData.child('authorUid').val() === auth.uid))",
              ".validate": "newData.val() === null || (newData.hasChildren(['commentId','placeId','authorProfileId','authorSurnameSnapshot','text','createdAt','updatedAt','authorUid']) && newData.child('commentId').isString() && newData.child('commentId').val() === $commentId && newData.child('placeId').isString() && newData.child('placeId').val() === $placeId && newData.child('authorProfileId').isString() && newData.child('authorProfileId').val().length > 0 && newData.child('authorSurnameSnapshot').isString() && newData.child('authorSurnameSnapshot').val().length > 0 && newData.child('authorSurnameSnapshot').val().length <= 80 && (!newData.child('reaction').exists() || newData.child('reaction').val() === 'like' || newData.child('reaction').val() === 'dislike') && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('createdAt').isNumber() && newData.child('updatedAt').isNumber() && newData.child('authorUid').isString() && newData.child('authorUid').val().length > 0)"
            }
          }
        },
        "placeVisibilityMap": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          "$placeId": {
            ".validate": "newData.val() === 'visible' || newData.val() === 'hiddenByOwner'"
          }
        },
        "placeDayOverrides": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          "$placeId": {
            ".validate": "newData.val() === null || newData.child('0').isNumber() || newData.child('days/0').isNumber()",
            "$index": {
              ".validate": "$index.matches(/^[0-9]+$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= 31"
            },
            "days": {
              "$index": {
                ".validate": "$index.matches(/^[0-9]+$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= 31"
              }
            },
            "orderByDay": {
              "$day": {
                ".validate": "$day.matches(/^[0-9]+$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= 99"
              }
            }
          }
        },
        "documentVisibilityMap": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          "$documentId": {
            ".validate": "newData.val() === 'visible' || newData.val() === 'hiddenByOwner'"
          }
        },
        "destinationSurvey": {
          "$profileId": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('families').child($familyId).child('phase').val() === 'before' && root.child('families').child($familyId).child('profiles').child($profileId).child('memberUids').child(auth.uid).val() === true",
            ".validate": "newData.val() === null || (newData.hasChildren(['profileId','proposals','updatedAt','authorUid']) && newData.child('proposals/0').exists() && !newData.child('proposals/3').exists())",
            "profileId": {
              ".validate": "newData.isString() && newData.val() === $profileId"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "authorUid": {
              ".validate": "newData.isString() && newData.val().length > 0 && auth != null && newData.val() === auth.uid"
            },
            "proposals": {
              "$idx": {
                ".validate": "$idx.matches(/^[0-2]$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "challengeReactions": {
          ".write": "auth != null",
          "$day": {
            "$targetProfileId": {
              "$reactorProfileId": {
                ".read": "auth != null",
                ".validate": "newData.val() === null || (newData.hasChildren(['day','targetProfileId','reactorProfileId','emoji','updatedAt','authorUid']) && newData.child('day').isNumber() && newData.child('targetProfileId').isString() && newData.child('targetProfileId').val() === $targetProfileId && newData.child('reactorProfileId').isString() && newData.child('reactorProfileId').val() === $reactorProfileId && (newData.child('emoji').val() === 'love' || newData.child('emoji').val() === 'laugh' || newData.child('emoji').val() === 'wow' || newData.child('emoji').val() === 'clap') && newData.child('updatedAt').isNumber() && newData.child('authorUid').isString() && newData.child('authorUid').val().length > 0)"
              }
            }
          }
        },
        "gameResults": {
          "$profileId": {
            ".write": "auth != null",
            "$index": {
              ".validate": "newData.hasChildren(['day','location','quizScore','correctCount','riddleSolved','challengeDone','durationSec','totalScore','completedAt'])"
            }
          }
        },
        "gameProgress": {
          "$profileId": {
            ".write": "auth != null",
            ".validate": "newData.val() === null || (newData.hasChildren(['day','phase','quizDurationSec','riddleValidated','riddleSolved']) && (newData.child('phase').val() === 'playing' || newData.child('phase').val() === 'riddle' || newData.child('phase').val() === 'challenge') && (!newData.child('quizStartedAt').exists() || newData.child('quizStartedAt').isNumber()))"
          }
        },
        "phase": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.val() === 'before' || newData.val() === 'during'"
        },
        "launchGateCycle": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "gameDayOverrides": {
          "$day": {
            ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
            ".validate": "newData.val() === null || newData.val() === 'open' || newData.val() === 'closed'"
          }
        },
        "tripStartDate": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "gameScoring": {
          ".write": "auth != null && root.child('ownerMembers').child($familyId).child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['questionPoints','riddlePoints','challengePoints','destinationProposalScoring']) && newData.child('questionPoints').isNumber() && newData.child('questionPoints').val() >= 0 && newData.child('riddlePoints').isNumber() && newData.child('riddlePoints').val() >= 0 && newData.child('challengePoints').isNumber() && newData.child('challengePoints').val() >= 0 && newData.child('destinationProposalScoring/0/basePoints').isNumber() && newData.child('destinationProposalScoring/0/basePoints').val() >= 0 && newData.child('destinationProposalScoring/0/bonusPoints').isNumber() && newData.child('destinationProposalScoring/0/bonusPoints').val() >= 0 && newData.child('destinationProposalScoring/1/basePoints').isNumber() && newData.child('destinationProposalScoring/1/basePoints').val() >= 0 && newData.child('destinationProposalScoring/1/bonusPoints').isNumber() && newData.child('destinationProposalScoring/1/bonusPoints').val() >= 0 && newData.child('destinationProposalScoring/2/basePoints').isNumber() && newData.child('destinationProposalScoring/2/basePoints').val() >= 0 && newData.child('destinationProposalScoring/2/bonusPoints').isNumber() && newData.child('destinationProposalScoring/2/bonusPoints').val() >= 0 && !newData.child('destinationProposalScoring/3').exists()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
